code = "shader_type sky;
uniform vec4 ColorParameter2 : source_color = vec4(0.000000, 0.615686, 0.000000, 1.000000);
uniform float ZenithBlend = 2;
uniform vec4 SkyColor : source_color = vec4(0.000000, 0.000000, 0.000000, 1.000000);
uniform float HorizonBlend = 50;
uniform vec4 HorizonColor : source_color = vec4(0.000000, 0.145098, 0.000000, 1.000000);
uniform float NadirBlend = 2;
uniform vec4 GroundColor : source_color = vec4(0.000000, 0.247059, 0.000000, 1.000000);


// SimpleNoise
float noise_random_value(vec2 uv){
	return fract(sin(dot(uv.xy, vec2(12.9898,78.233))) * 43758.5453123);
}

float value_noise(vec2 uv){
	vec2 _floor = floor(uv);
	vec2 _fraction = fract(uv);
	_fraction = _fraction * _fraction * (3.0 - 2.0 * _fraction);
	vec2 _corner = vec2(1.0, 0.0);

	float _c0 = noise_random_value(_floor + _corner.yy);
	float _c1 = noise_random_value(_floor + _corner.xy);
	float _c2 = noise_random_value(_floor + _corner.yx);
	float _c3 = noise_random_value(_floor + _corner.xx);

	vec2 _blur = smoothstep(0.0, 1.0, _fraction);
	float mix_one = mix(_c0, _c1, _blur.x) + (_c2 - _c0) * _blur.y * (1.0 - _blur.x) + (_c3 - _c1) * _blur.x * _blur.y;
	return mix_one;
}

float simple_noise(vec2 uv, float scale){
	int octaves = 6;
	float amplitude = 0.25;
	float value = 0.0;

	for(int i = 0; i < octaves; i++) {
		value += amplitude * value_noise(scale * uv);
		amplitude *= 0.85;
		scale *= 3.0;
	}
	return value;
}

void sky() {
// ColorParameter:27
	vec4 n_out27p0 = ColorParameter2;


// Input:3
	vec3 n_out3p0 = EYEDIR;
	float n_out3p1 = n_out3p0.r;
	float n_out3p2 = n_out3p0.g;
	float n_out3p3 = n_out3p0.b;


// VectorCompose:26
	vec2 n_out26p0 = vec2(n_out3p1, n_out3p3);


// VectorOp:30
	vec3 n_out30p0 = vec3(n_out26p0, 0.0) / vec3(n_out3p2);


// Input:32
	float n_out32p0 = TIME;


// VectorOp:33
	vec2 n_in33p1 = vec2(0.00000, 0.01200);
	vec2 n_out33p0 = vec2(n_out32p0) * n_in33p1;


// UVFunc:34
	vec2 n_in34p1 = vec2(1.00000, 1.00000);
	vec2 n_out34p0 = n_out33p0 * n_in34p1 + vec2(n_out30p0.xy);


	float n_out29p0;
// SimpleNoise:29
	float n_in29p1 = 1.00000;
	{
		n_out29p0 = simple_noise(n_out34p0, n_in29p1);
	}


// VectorOp:31
	vec3 n_out31p0 = vec3(n_out27p0.xyz) * vec3(n_out29p0);


// FloatOp:4
	float n_in4p1 = 0.00000;
	float n_out4p0 = max(n_out3p2, n_in4p1);


// FloatParameter:12
	float n_out12p0 = ZenithBlend;


// FloatOp:10
	float n_out10p0 = pow(n_out4p0, n_out12p0);


// VectorOp:24
	vec3 n_out24p0 = n_out31p0 * vec3(n_out10p0);


// ColorParameter:15
	vec4 n_out15p0 = SkyColor;


// VectorOp:18
	vec3 n_out18p0 = vec3(n_out15p0.xyz) * vec3(n_out10p0);


// VectorOp:25
	vec3 n_out25p0 = n_out24p0 + n_out18p0;


// FloatOp:5
	float n_in5p1 = 0.00000;
	float n_out5p0 = min(n_out3p2, n_in5p1);


// FloatFunc:6
	float n_out6p0 = abs(n_out5p0);


// FloatOp:7
	float n_out7p0 = n_out4p0 + n_out6p0;


// FloatFunc:8
	float n_out8p0 = 1.0 - n_out7p0;


// FloatParameter:14
	float n_out14p0 = HorizonBlend;


// FloatOp:9
	float n_out9p0 = pow(n_out8p0, n_out14p0);


// ColorParameter:16
	vec4 n_out16p0 = HorizonColor;


// VectorOp:19
	vec3 n_out19p0 = vec3(n_out9p0) * vec3(n_out16p0.xyz);


// VectorOp:21
	vec3 n_out21p0 = n_out25p0 + n_out19p0;


// FloatParameter:13
	float n_out13p0 = NadirBlend;


// FloatOp:11
	float n_out11p0 = pow(n_out6p0, n_out13p0);


// ColorParameter:17
	vec4 n_out17p0 = GroundColor;


// VectorOp:20
	vec3 n_out20p0 = vec3(n_out11p0) * vec3(n_out17p0.xyz);


// VectorOp:22
	vec3 n_out22p0 = n_out21p0 + n_out20p0;


// Output:0
	COLOR = n_out22p0;


}
